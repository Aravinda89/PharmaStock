{
  "name": "pharmastock",
  "version": "1.0.0",
  "description": "PharmaStock - Pharmacy Inventory Management System for a small pharmacy",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm --prefix web install && npm run build",
    "build": "npm --prefix web run build",
    "start": "node server/index.js",
    "dev": "concurrently -n server,web -c cyan,magenta \"node --watch server/index.js\" \"npm --prefix web run dev\"",
    "seed": "node server/db/seed.js",
    "seed:demo": "node server/db/seed.js --demo",
    "test": "node --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0"
  }
}
